# ─────────────────────────────────────────────────────────────────
# KickoffPro — Environment Variables
# Copy this file to .env.local and fill in real values.
# NEVER commit .env.local to git.
# ─────────────────────────────────────────────────────────────────

# ── Supabase ──────────────────────────────────────────────────────
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbG...
SUPABASE_SERVICE_ROLE_KEY=eyJhbG...          # Server-only — NEVER prefix with NEXT_PUBLIC_

# ── Razorpay ──────────────────────────────────────────────────────
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_live_xxxx    # Public (used in frontend checkout)
RAZORPAY_KEY_SECRET=xxxxxxxxxxxx             # Server-only

# ── Zoho SMTP — Transactional email (orders, support, hello) ──────
SMTP_HOST=smtppro.zoho.in                     # Standard Zoho SMTP host
SMTP_PORT=465                                 # 465 (SSL) or 587 (TLS)

SMTP_HELLO_USER=hello@yourdomain.com          # Default mailbox user
SMTP_HELLO_PASS=xxxxxxxxxxxx                 # Default mailbox password

# Optional separate mailboxes (falls back to SMTP_HELLO_* if not set)
# SMTP_ORDERS_USER=orders@yourdomain.com
# SMTP_ORDERS_PASS=xxxxxxxxxxxx
# SMTP_SUPPORT_USER=support@yourdomain.com
# SMTP_SUPPORT_PASS=xxxxxxxxxxxx

# ── Email sender addresses ────────────────────────────────────────
EMAIL_FROM=KickoffPro Hello <hello@yourdomain.com>

# ── App ───────────────────────────────────────────────────────────
NEXT_PUBLIC_URL=https://yourdomain.com
LOCAL_DEV_ADMIN=false                         # Set to true in .env.local to bypass admin login on localhost only


# ── Tracking & Conversions API (CAPI) ──────────────────────────────
NEXT_PUBLIC_META_PIXEL_ID=1234567890123456        # Meta Pixel ID
META_CAPI_ACCESS_TOKEN=EAAG...                   # Meta System User Access Token for CAPI

NEXT_PUBLIC_GOOGLE_TAG_ID=G-XXXXXXXXXX           # Google Tag / GA4 Measurement ID
GA_API_SECRET=xxxxxxxxxxxxxxxxxxxx               # GA4 Measurement Protocol API Secret

NEXT_PUBLIC_SNAP_PIXEL_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx # Snapchat Pixel ID
SNAPCHAT_CAPI_TOKEN=xxxxxxxxxxxxxxxx             # Snapchat Marketing API Token

# ── Future: mail domain separation (add when ready) ───────────────
# EMAIL_MARKETING_FROM=KickoffPro <hello@yourdomain.com>
# EMAIL_SUPPORT_FROM=KickoffPro <support@yourdomain.com>
# EMAIL_AUTH_FROM=KickoffPro <auth@yourdomain.com>
